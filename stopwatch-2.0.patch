+class StopwatchDatabaseTest {
+    private val context: Context get() = RuntimeEnvironment.getApplication()
+
+    private fun oldDatabase(version: Int, legacyLaps: Boolean = false): String {
+        val name = "migration-${UUID.randomUUID()}.db"
+        val file = context.getDatabasePath(name)
+        file.parentFile!!.mkdirs()
+        val schema = javaClass.classLoader!!.getResourceAsStream(
+            "com.simplemobiletools.clock.databases.AppDatabase/$version.json"
+        )!!.bufferedReader().use { it.readText() }
+        val entities = JSONObject(schema).getJSONObject("database").getJSONArray("entities")
+        SQLiteDatabase.openOrCreateDatabase(file, null).use { db ->
+            for (index in 0 until entities.length()) {
+                val entity = entities.getJSONObject(index)
+                var sql = entity.getString("createSql").replace("\${TABLE_NAME}", entity.getString("tableName"))
+                if (legacyLaps && entity.getString("tableName") == "laps") {
+                    sql = sql.replace(", `millisecondsLag` INTEGER NOT NULL", "")
+                        .replace(", `sequence` INTEGER NOT NULL", "")
+                }
+                db.execSQL(sql)
+            }
+            val oneShot = if (version >= 2) ",oneShot" else ""
+            val oneShotValue = if (version >= 2) ",0" else ""
+            db.execSQL("INSERT INTO timers (id,seconds,state,vibrate,soundUri,soundTitle,label,createdAt$oneShot) VALUES (1,60,'{}',0,'','','keep timer',1$oneShotValue)")
+            if (version == 3) {
+                if (legacyLaps) {
+                    db.execSQL("INSERT INTO laps VALUES (1,1,1234,'keep text','keep label',1,NULL)")
+                    db.execSQL("INSERT INTO laps VALUES (2,1,2000,'second','keep label',1,NULL)")
+                } else {
+                    db.execSQL("INSERT INTO laps VALUES (1,1,1234,1234,'keep text','keep label',1,NULL,1)")
+                }
+            }
+            db.version = version
+        }
+        return name
+    }
+
+    private fun open(name: String) = Room.databaseBuilder(context, AppDatabase::class.java, name)
+        .addMigrations(AppDatabase.MIGRATION_1_2, AppDatabase.MIGRATION_2_3, AppDatabase.MIGRATION_3_4)
+        .allowMainThreadQueries()
+        .build()
+
+    @Test fun migrateVersionOnePreservesTimerAndCreatesUsableLaps() = verifyMigration(1)
+    @Test fun migrateVersionTwoPreservesTimerAndCreatesUsableLaps() = verifyMigration(2)
+
+    private fun verifyMigration(version: Int) {
+        val name = oldDatabase(version)
+        open(name).withDatabase { db ->
+            val connection = db.openHelper.writableDatabase // Room validates the migrated schema here.
+            connection.query("SELECT label FROM timers WHERE id=1").use {
+                assertTrue(it.moveToFirst())
+                assertEquals("keep timer", it.getString(0))
+            }
+            assertTrue(db.StopwatchDao().getLaps().isEmpty())
+            val (setId, ids) = db.StopwatchDao().saveSet(listOf(lap()))
+            assertEquals(1, setId)
+            assertEquals(1, ids.size)
+        }
+        context.deleteDatabase(name)
+    }
+
+    @Test fun versionThreeHistoryOpensWithoutDestructiveMigration() {
+        val name = oldDatabase(3)
+        open(name).withDatabase { db ->
+            val saved = db.StopwatchDao().getLaps().single()
+            assertEquals("keep text", saved.text)
+            assertEquals("keep label", saved.label)
+            assertEquals(1234L, saved.milliseconds)
+        }
+        context.deleteDatabase(name)
+    }
+
+    @Test fun olderVersionThreeLayoutGetsMissingColumnsWithoutLosingHistory() {
+        val name = oldDatabase(3, legacyLaps = true)
+        open(name).withDatabase { db ->
+            val saved = db.StopwatchDao().getLaps()
+            assertEquals(listOf("keep text", "second"), saved.map { it.text })
+            assertEquals(listOf(1234L, 766L), saved.map { it.millisecondsLag })
+            assertEquals(listOf(1, 2), saved.map { it.sequence })
+        }
+        context.deleteDatabase(name)
+    }
+
+    @Test fun savingAgainReplacesTheSameSetAndAllocatesANewNumberOnlyForANewMeasurement() {
+        Room.inMemoryDatabaseBuilder(context, AppDatabase::class.java).allowMainThreadQueries().build().withDatabase { db ->
+            val dao = db.StopwatchDao()
+            assertEquals(0 to emptyList<Long>(), dao.saveSet(emptyList()))
+            val (setId, _) = dao.saveSet(listOf(lap()))
+            assertEquals("1", dao.getLaps().single().label)
+            dao.saveSet(listOf(lap().copy(stopwatchSetNum = setId, text = "updated")))
+            assertEquals(1, dao.getLaps().size)
+            assertEquals("updated", dao.getLaps().single().text)
+            assertEquals(2, dao.saveSet(listOf(lap())).first)
+            assertEquals(2, dao.getLaps().size)
+        }
+    }
+
+    @Test fun replacementRollsBackDeletionIfAnInsertFails() {
+        Room.inMemoryDatabaseBuilder(context, AppDatabase::class.java).allowMainThreadQueries().build().withDatabase { db ->
+            val dao = db.StopwatchDao()
+            val setId = dao.saveSet(listOf(lap().copy(text = "original"))).first
+            db.openHelper.writableDatabase.execSQL("CREATE TRIGGER reject_new_laps BEFORE INSERT ON laps BEGIN SELECT RAISE(ABORT, 'test failure'); END")
+            try {
+                dao.saveSet(listOf(lap().copy(stopwatchSetNum = setId, text = "replacement")))
+                fail("Expected insert failure")
+            } catch (_: android.database.SQLException) {
+                assertEquals("original", dao.getLaps().single().text)
+            }
+        }
+    }
+
+    private inline fun <T> AppDatabase.withDatabase(block: (AppDatabase) -> T): T {
+        return try {
+            block(this)
+        } finally {
+            close()
+        }
+    }
+
+    private fun lap() = Stopwatch(
+        stopwatchSetNum = 0, milliseconds = 1234L, millisecondsLag = 1234L,
+        text = "", label = "", createdAt = 1L, sequence = 1,
+    )
+}
diff --git a/app/src/test/kotlin/com/simplemobiletools/clock/helpers/StopwatchEngineTest.kt b/app/src/test/kotlin/com/simplemobiletools/clock/helpers/StopwatchEngineTest.kt
new file mode 100644
index 0000000..4b41b84
--- /dev/null
+++ b/app/src/test/kotlin/com/simplemobiletools/clock/helpers/StopwatchEngineTest.kt
@@ -0,0 +1,159 @@
+package com.simplemobiletools.clock.helpers
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class StopwatchEngineTest {
+    private var now = 50_000L
+    private val stopwatch = StopwatchEngine { now }
+
+    @Test fun pauseDoesNotDoubleElapsedTimeAndIgnoresPausedTime() {
+        stopwatch.start()
+        now += 10_000
+        stopwatch.pause()
+        assertEquals(10_000L, stopwatch.reading().totalTime)
+        now += 60_000
+        stopwatch.pause()
+        assertEquals(10_000L, stopwatch.reading().totalTime)
+        stopwatch.start()
+        now += 2_345
+        stopwatch.pause()
+        assertEquals(12_345L, stopwatch.reading().totalTime)
+        assertEquals(12_345L, stopwatch.reading().lapTime)
+    }
+
+    @Test fun sleepAndDelayedDisplayCallbacksDoNotLoseTime() {
+        stopwatch.start()
+        now += 6 * 60 * 60 * 1_000L
+        assertEquals(21_600_000L, stopwatch.reading().totalTime)
+        stopwatch.lap()
+        assertEquals(21_600_000L, stopwatch.laps()[1].totalTime)
+    }
+
+    @Test fun repeatedStartDoesNotRestartTheMeasurement() {
+        stopwatch.start()
+        now += 1_000
+        stopwatch.start()
+        now += 500
+        assertEquals(1_500L, stopwatch.reading().totalTime)
+        assertEquals(1, stopwatch.laps().size)
+    }
+
+    @Test fun firstLapIsMeasuredFromStartAndKeepsItsText() {
+        stopwatch.start()
+        stopwatch.updateLapText(1, "Первый этап")
+        now += 1_234
+        stopwatch.lap()
+        assertEquals(1_234L, stopwatch.laps()[1].lapTime)
+        assertEquals(1_234L, stopwatch.laps()[1].totalTime)
+        assertEquals("Первый этап", stopwatch.laps()[1].textTime)
+        assertEquals(0L, stopwatch.laps()[0].lapTime)
+        now += 765
+        stopwatch.lap()
+        assertEquals(765L, stopwatch.laps()[1].lapTime)
+        assertEquals(1_999L, stopwatch.laps()[1].totalTime)
+        assertEquals("Первый этап", stopwatch.laps()[2].textTime)
+    }
+
+    @Test fun lapDurationExcludesPausesAndUsesTheExactCaptureTime() {
+        stopwatch.start()
+        now += 1_000
+        stopwatch.lap()
+        now += 200
+        stopwatch.pause()
+        now += 5_000
+        stopwatch.start()
+        now += 300
+        stopwatch.lap()
+        assertEquals(500L, stopwatch.laps()[1].lapTime)
+        assertEquals(1_500L, stopwatch.laps()[1].totalTime)
+    }
+
+    @Test fun runningMeasurementCanBeRestoredWithoutATickingService() {
+        stopwatch.start()
+        now += 2_000
+        stopwatch.lap()
+        stopwatch.updateLapText(2, "Продолжение")
+        stopwatch.currentSetId = 7
+        now += 500
+        val saved = stopwatch.snapshot()
+        now += 30_000
+        val restored = StopwatchEngine { now }
+        restored.restore(saved, sameBoot = true)
+        assertEquals(StopwatchEngine.State.RUNNING, restored.state)
+        assertEquals(32_500L, restored.reading().totalTime)
+        assertEquals(30_500L, restored.reading().lapTime)
+        assertEquals("Продолжение", restored.laps()[0].textTime)
+        assertEquals(7, restored.currentSetId)
+        restored.lap()
+        assertEquals(3, restored.laps()[0].id)
+    }
+
+    @Test fun pausedMeasurementStaysPausedAfterRestore() {
+        stopwatch.start()
+        now += 900
+        stopwatch.pause()
+        val saved = stopwatch.snapshot()
+        now += 20_000
+        val restored = StopwatchEngine { now }
+        restored.restore(saved, sameBoot = true)
+        assertEquals(StopwatchEngine.State.PAUSED, restored.state)
+        assertEquals(900L, restored.reading().totalTime)
+    }
+
+    @Test fun rebootPreservesTheLastCheckpointAndPausesTheMeasurement() {
+        stopwatch.start()
+        now += 900
+        val saved = stopwatch.snapshot()
+        // Even if the next boot has a larger uptime, its time must not be added.
+        now += 100_000
+        val restored = StopwatchEngine { now }
+        restored.restore(saved, sameBoot = false)
+        assertEquals(StopwatchEngine.State.PAUSED, restored.state)
+        assertEquals(900L, restored.reading().totalTime)
+        assertEquals(1, restored.laps().size)
+    }
+
+    @Test fun backwardsClockIsAlsoTreatedAsAReboot() {
+        stopwatch.start()
+        now += 900
+        val saved = stopwatch.snapshot()
+        now = 100
+        val restored = StopwatchEngine { now }
+        restored.restore(saved, sameBoot = true)
+        assertEquals(StopwatchEngine.State.PAUSED, restored.state)
+        assertEquals(900L, restored.reading().totalTime)
+    }
+
+    @Test fun resetClearsTimesLapsAndTheSavedSetIdentity() {
+        stopwatch.start()
+        now += 100
+        stopwatch.lap()
+        stopwatch.currentSetId = 4
+        stopwatch.reset()
+        assertEquals(StopwatchEngine.State.RESETED, stopwatch.state)
+        assertEquals(0L, stopwatch.reading().totalTime)
+        assertEquals(0L, stopwatch.reading().lapTime)
+        assertTrue(stopwatch.laps().isEmpty())
+        assertEquals(0, stopwatch.currentSetId)
+        stopwatch.start()
+        assertEquals(1, stopwatch.laps().single().id)
+    }
+
+    @Test fun callersCannotMutateEngineStateThroughASnapshot() {
+        stopwatch.start()
+        stopwatch.laps().single().textTime = "External mutation"
+        stopwatch.snapshot().laps.single().totalTime = 999
+        assertEquals("", stopwatch.laps().single().textTime)
+        assertEquals(0L, stopwatch.laps().single().totalTime)
+    }
+
+    @Test fun lapIsIgnoredUnlessTheStopwatchIsRunning() {
+        stopwatch.lap()
+        assertTrue(stopwatch.laps().isEmpty())
+        stopwatch.start()
+        stopwatch.pause()
+        stopwatch.lap()
+        assertEquals(1, stopwatch.laps().size)
+    }
+}
